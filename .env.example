# Copy this file to .env and fill in your values
# cp .env.example .env

# Database
# Used by the app container to connect to PostgreSQL (with pgvector)
# For docker compose: use the postgres service hostname
DATABASE_URL=postgresql://productos:productos@postgres:5432/productos
# For local dev without docker: use localhost
# DATABASE_URL=postgresql://productos:productos@localhost:5432/productos

# Redis
# Used for caching, session store, and future queue support
REDIS_URL=redis://redis:6379

# AI (Anthropic)
# Required for AI features (Stories 2.x+)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# NextAuth
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-change-me-in-production
NEXTAUTH_URL=http://localhost:3000
